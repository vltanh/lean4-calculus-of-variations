/-!
# Dacorogna's formula for the quasiconvex envelope

For a continuous `f : ℝ^{d×m} → ℝ`, every nonempty bounded open `Ω ⊆ ℝ^m` and every `A`,
`f^{qc} (A) = inf_φ ⨍_Ω f (A + ∇φ)` over the Lipschitz `φ` vanishing outside `Ω`, with values in
`EReal` (`qcEnvelope_eq_iInf`); in particular over the Euclidean unit ball
(`qcEnvelope_eq_iInf_unitBall`). D. Kinderlehrer and P. Pedregal, *Characterizations of Young
measures generated by gradients*, Arch. Rational Mech. Anal. 115 (1991), 329–365, Proposition 8.1,
state the formula for continuous integrands that need not be bounded below, and B. Dacorogna,
*Quasiconvexity and relaxation of nonconvex problems in the calculus of variations*, J. Funct.
Anal. 46 (1982), 102–118, proved it first. Neither proof was accessible; the argument used is the
proof of S. Müller, *Variational models for microstructure and phase transitions*, lecture notes,
MPI MiS Leipzig, 1998, Theorem 4.5 (iii), §4.8, with the unit cube `Q` for Müller's domain `U`
and `Qf = cubeInf f`:

* (b) `qcEnvelope f ≤ inf_Ω`: a quasiconvex minorant of `f` is quasiconvex on `Ω`
  (`quasiconvexAtOn_iff`, Müller's Remark 2 after Definition 4.2), hence below every average over
  `Ω` (`env_le_average`);
* (a) `inf_Ω ≤ cubeInf f`, the covering half of the independence of the domain: rescaled copies
  of a test map on the cube, glued into finitely many disjoint small cubes filling `Ω` up to `ε`
  (`env_iInf_le_cubeInf`);
* (c)–(g) `cubeInf f ≤ qcEnvelope f` (`cubeInf_le_qcEnvelope`, `Envelope.Convexity`): `cubeInf f`
  is `≡ −∞` or a continuous quasiconvex minorant of `f`.
-/

@[expose] public section

open MeasureTheory

namespace CalculusOfVariations

/-! ### The Euclidean unit ball -/

section Ball

variable {d m : ℕ}

open Metric Set Filter Topology

theorem cv_unitBall_isOpen : IsOpen (unitBall m) :=
  isOpen_lt (continuous_finsetSum _ fun i _ => (continuous_apply i).pow 2) continuous_const

theorem cv_sq_le_of_mem_unitBall {x : Fin m → ℝ} (hx : x ∈ closure (unitBall m)) (i : Fin m) :
    x i ^ 2 ≤ 1 := by
  have hc : IsClosed {x : Fin m → ℝ | ∑ i, x i ^ 2 ≤ 1} :=
    isClosed_le (continuous_finsetSum _ fun i _ => (continuous_apply i).pow 2) continuous_const
  have hsub : closure (unitBall m) ⊆ {x : Fin m → ℝ | ∑ i, x i ^ 2 ≤ 1} :=
    closure_minimal (fun y (hy : ∑ i, y i ^ 2 < 1) => (le_of_lt hy : ∑ i, y i ^ 2 ≤ 1)) hc
  exact (Finset.single_le_sum (f := fun i => x i ^ 2) (fun i _ => sq_nonneg _)
    (Finset.mem_univ i)).trans (hsub hx)

theorem cv_unitBall_subset : unitBall m ⊆ closedBall (0 : Fin m → ℝ) 1 := by
  intro x hx
  rw [mem_closedBall, dist_zero_right, pi_norm_le_iff_of_nonneg zero_le_one]
  intro i
  have := cv_sq_le_of_mem_unitBall (subset_closure hx) i
  rw [Real.norm_eq_abs]
  nlinarith [abs_nonneg (x i), sq_abs (x i)]

theorem cv_unitBall_convex : Convex ℝ (unitBall m) := by
  intro x hx y hy a b ha hb hab
  change ∑ i, (a • x + b • y) i ^ 2 < 1
  have hx' : ∑ i, x i ^ 2 < 1 := hx
  have hy' : ∑ i, y i ^ 2 < 1 := hy
  have h : ∀ i, (a • x + b • y) i ^ 2 ≤ a * x i ^ 2 + b * y i ^ 2 := by
    intro i
    simp only [Pi.add_apply, Pi.smul_apply, smul_eq_mul]
    have : a * x i ^ 2 + b * y i ^ 2 - (a * x i + b * y i) ^ 2 = a * b * (x i - y i) ^ 2 := by
      have hb' : b = 1 - a := by linarith
      subst hb'; ring
    nlinarith [mul_nonneg (mul_nonneg ha hb) (sq_nonneg (x i - y i))]
  calc ∑ i, (a • x + b • y) i ^ 2 ≤ ∑ i, (a * x i ^ 2 + b * y i ^ 2) :=
        Finset.sum_le_sum fun i _ => h i
    _ = a * ∑ i, x i ^ 2 + b * ∑ i, y i ^ 2 := by
        rw [Finset.sum_add_distrib, Finset.mul_sum, Finset.mul_sum]
    _ < 1 := by
        rcases ha.lt_or_eq with ha' | ha'
        · nlinarith
        · subst ha'; simp at hab; subst hab; simpa using hy'

theorem cv_unitBall_pos : 0 < volume (unitBall m) :=
  cv_unitBall_isOpen.measure_pos volume ⟨0, by simp [unitBall]⟩

theorem cv_unitBall_ne_top : volume (unitBall m) ≠ ⊤ :=
  ne_top_of_le_ne_top measure_closedBall_lt_top.ne (measure_mono cv_unitBall_subset)

theorem cv_frontier_unitBall : volume (frontier (unitBall m)) = 0 :=
  Convex.addHaar_frontier volume cv_unitBall_convex

end Ball

/-! ### The infimum formula over a bounded open set -/

section Domain

variable {d m : ℕ}

open Metric Set Filter Topology

/-- **A quasiconvex minorant is below the averages over `Ω`** (Müller 1998, §4.8: "by the
definition of quasiconvexity `Qf ≥ Qf^{qc} = f^{qc}`"). For an admissible `g` (lower
semicontinuous, locally bounded, quasiconvex on the unit cube, `g ≤ f`), a nonempty bounded open
`Ω` and a test map `ψ` on `Ω`: `g` is quasiconvex on `Ω` (`quasiconvexAtOn_iff`, Müller's
Remark 2 after Definition 4.2), so `|Ω| g (A) ≤ ∫_Ω g (A + ∇ψ) ≤ ∫_Ω f (A + ∇ψ)`. -/
theorem env_le_average {f g : Matrix (Fin d) (Fin m) ℝ → ℝ} (hlsc : LowerSemicontinuous g)
    (hbdd : IsLocallyBounded g) (hqc : Quasiconvex g) (hgf : ∀ B, g B ≤ f B)
    (hf : Continuous f) {Ω : Set (Fin m → ℝ)} (hΩ : IsOpen Ω) (hb : Bornology.IsBounded Ω)
    (hne : Ω.Nonempty) (A : Matrix (Fin d) (Fin m) ℝ) {ψ : (Fin m → ℝ) → Fin d → ℝ}
    (hψ : (∃ K, LipschitzWith K ψ) ∧ ∀ x ∉ Ω, ψ x = 0) :
    g A ≤ (volume Ω).toReal⁻¹ * ∫ x in Ω, f (A + grad ψ x) := by
  obtain ⟨⟨K, hK⟩, hψΩ⟩ := hψ
  have hfin : volume Ω < ⊤ := hb.measure_lt_top
  have hpos : 0 < (volume Ω).toReal :=
    ENNReal.toReal_pos (hΩ.measure_pos volume hne).ne' hfin.ne
  have hint := rd_integrableOn hlsc hbdd A hK hfin
  have h1 := (quasiconvexAtOn_iff hlsc hbdd A hΩ hb hne).1 (hqc A) ψ K hK hψΩ hint
  have h2 : ∫ x in Ω, g (A + grad ψ x) ≤ ∫ x in Ω, f (A + grad ψ x) :=
    setIntegral_mono_on hint (cv_integrableOn hf A hK hfin.ne) hΩ.measurableSet
      fun y _ => hgf _
  rw [le_inv_mul_iff₀ hpos]
  linarith

/-- The arithmetic of the gluing into `Ω`. -/
theorem env_glue_estimate {m : ℕ} {ε b T I M G : ℝ} (hε0 : 0 < ε) (hε1 : ε < 1 / 2) (hb : 0 < b)
    (hM0 : 0 ≤ M) (hT0 : 0 ≤ T) (hT1 : b - ε ≤ T) (hT2 : T ≤ b)
    (hG : G ≤ (1 - ε) ^ m * T * I + M * (b - (1 - ε) ^ m * T)) :
    b⁻¹ * G ≤ I + b⁻¹ * (m * b + 1) * (M + |I|) * ε := by
  have hpow0 : 0 ≤ (1 - ε) ^ m := pow_nonneg (by linarith) m
  have hpow1 : (1 - ε) ^ m ≤ 1 := pow_le_one₀ (by linarith) (by linarith)
  have hbern : 1 + (m : ℝ) * (-ε) ≤ (1 + -ε) ^ m :=
    one_add_le_pow_of_two_add_nonneg (by linarith) m
  rw [← sub_eq_add_neg] at hbern
  have hm0 : (0 : ℝ) ≤ m := Nat.cast_nonneg m
  have hbern' : 1 - m * ε ≤ (1 - ε) ^ m := by linarith
  set a := (1 - ε) ^ m * T with ha
  have ha1 : a ≤ b := by nlinarith
  have ha2 : b - a ≤ (m * b + 1) * ε := by
    have h1 : (1 - ε) ^ m * (b - ε) ≤ a := mul_le_mul_of_nonneg_left hT1 hpow0
    have h2 : (1 - m * ε) * (b - ε) ≤ (1 - ε) ^ m * (b - ε) ∨ b - ε < 0 := by
      rcases le_or_gt 0 (b - ε) with h | h
      · exact Or.inl (mul_le_mul_of_nonneg_right hbern' h)
      · exact Or.inr h
    rcases h2 with h2 | h2
    · have : 0 ≤ (m : ℝ) * ε * ε := by positivity
      nlinarith
    · nlinarith
  have hkey : G ≤ b * I + (b - a) * (M + |I|) := by
    have e : a * I + M * (b - a) = b * I + (b - a) * (M - I) := by ring
    have h3 : (b - a) * (M - I) ≤ (b - a) * (M + |I|) :=
      mul_le_mul_of_nonneg_left (by linarith [neg_abs_le I]) (by linarith)
    linarith
  rw [inv_mul_le_iff₀ hb]
  have h4 : (b - a) * (M + |I|) ≤ (m * b + 1) * ε * (M + |I|) :=
    mul_le_mul_of_nonneg_right ha2 (by positivity)
  have e : b * (I + b⁻¹ * (m * b + 1) * (M + |I|) * ε) = b * I + (m * b + 1) * ε * (M + |I|) := by
    field_simp
  rw [e]
  linarith

/-- **Gluing into `Ω`** (the covering half of Müller's "a simple scaling and covering argument
shows that `Qf` is independent of `U`"). For an open `Ω` with `0 < |Ω| < ∞` and a test map `φ`
on the cube: finitely many disjoint small cubes fill `Ω` up to `ε` (`cv_exists_finite_cover`), and
rescaled copies of `φ` glued into them (`cv_glue_on`, with the map `0` outside) give a test map
`Φ` on `Ω` with `⨍_Ω f (A + ∇Φ) ≤ ∫_Q f (A + ∇φ) + O(ε)`. Hence the infimum formula over `Ω` is
at most `cubeInf f`. -/
theorem env_iInf_le_cubeInf {f : Matrix (Fin d) (Fin m) ℝ → ℝ} (hf : Continuous f)
    {Ω : Set (Fin m → ℝ)} (hΩ : IsOpen Ω) (hpos : 0 < volume Ω) (hfin : volume Ω ≠ ⊤)
    (A : Matrix (Fin d) (Fin m) ℝ) :
    (⨅ (φ : (Fin m → ℝ) → Fin d → ℝ) (_ : (∃ K, LipschitzWith K φ) ∧ ∀ x ∉ Ω, φ x = 0),
      (((volume Ω).toReal⁻¹ * ∫ x in Ω, f (A + grad φ x) : ℝ) : EReal)) ≤ cubeInf f A := by
  refine le_iInf₂ fun φ hφ => ?_
  obtain ⟨⟨K, hK⟩, hφQ⟩ := hφ
  set I := ∫ y in unitCube m, f (A + grad φ y) with hI
  set b := (volume Ω).toReal with hbdef
  have hb : 0 < b := ENNReal.toReal_pos hpos.ne' hfin
  obtain ⟨M, hM0, hM⟩ := cv_bdd hf A (3 * (0 : NNReal) + 1)
  refine cv_ereal_le_of_eps (C := b⁻¹ * (m * b + 1) * (M + |I|)) (by positivity)
    fun ε hε0 hε1 => ?_
  -- the cover of `Ω` by small cubes
  obtain ⟨t, htP, htdisj, htvol⟩ := cv_exists_finite_cover (s := Ω) hfin
    hΩ.measurableSet (fun x r => closedBall x r ⊆ Ω)
    (Filter.Eventually.of_forall fun x hx δ hδ => by
      obtain ⟨ε', hε', hball⟩ := Metric.isOpen_iff.1 hΩ x hx
      refine ⟨min (δ / 2) (ε' / 2), ⟨lt_min (by linarith) (by linarith),
        (min_le_left _ _).trans_lt (by linarith)⟩, ?_⟩
      exact (closedBall_subset_ball ((min_le_right _ _).trans_lt (by linarith))).trans hball)
    (ENNReal.ofReal_pos.2 hε0)
  have hzero : ∀ x, tangentMap (fun _ : Fin m → ℝ => (0 : Fin d → ℝ)) x = fun _ => 0 := by
    intro x; ext z; simp [tangentMap]
  obtain ⟨Φ, ⟨hΦL, hΦB⟩, hΦle⟩ := cv_glue_on hf A (φ := fun _ => 0) (K := 0)
    (LipschitzWith.const _) hfin (fun _ _ => rfl) hε0 (by linarith) t
    (fun p hp => ⟨(htP p hp).1, (htP p hp).2, differentiableAt_const _, fun z _ => by
      rw [hzero]; simp only [sub_self, norm_zero]
      exact mul_nonneg hε0.le (htP p hp).1.le⟩) htdisj (fun _ => φ)
    (fun _ _ => ⟨⟨K, hK⟩, hφQ⟩) hM
  have hg0 : ∀ x, grad (fun _ : Fin m → ℝ => (0 : Fin d → ℝ)) x = 0 := fun x =>
    cv_grad_eq_zero (Filter.Eventually.of_forall fun _ => rfl)
  simp only [hg0, add_zero] at hΦle
  refine (iInf₂_le Φ ⟨hΦL, hΦB⟩).trans (EReal.coe_le_coe_iff.2 ?_)
  -- the measures
  have hV : ∀ p ∈ t, volume.real (closedBall p.1 p.2) = (2 * p.2) ^ m := fun p hp =>
    cv_measureReal_closedBall _ (htP p hp).1.le
  set T := ∑ p ∈ t, volume.real (closedBall p.1 p.2) with hTdef
  have hUC : (⋃ p ∈ t, closedBall p.1 p.2) ⊆ Ω := by
    intro z hz
    obtain ⟨p, hp, hzp⟩ := mem_iUnion₂.1 hz
    exact (htP p hp).2 hzp
  have hUCm : MeasurableSet (⋃ p ∈ t, closedBall p.1 p.2) :=
    Finset.measurableSet_biUnion _ fun _ _ => measurableSet_closedBall
  have hT : T = volume.real (⋃ p ∈ t, closedBall p.1 p.2) :=
    (measureReal_biUnion_finset htdisj (fun _ _ => measurableSet_closedBall)
      (fun _ _ => measure_closedBall_lt_top.ne)).symm
  have hrest : volume.real (Ω \ ⋃ p ∈ t, closedBall p.1 p.2) ≤ ε :=
    (ENNReal.toReal_lt_of_lt_ofReal htvol).le
  have hbB : volume.real Ω = b := by rw [hbdef, measureReal_def]
  have hTeq : T = b - volume.real (Ω \ ⋃ p ∈ t, closedBall p.1 p.2) := by
    rw [measureReal_sdiff hUC hUCm hfin, hbB, hT]; ring
  have hrest0 : 0 ≤ volume.real (Ω \ ⋃ p ∈ t, closedBall p.1 p.2) := measureReal_nonneg
  set U := ⋃ p ∈ t, ball p.1 ((1 - ε) * p.2) with hUdef
  have hUB : U ⊆ Ω := by
    intro z hz
    obtain ⟨p, hp, hzp⟩ := mem_iUnion₂.1 hz
    have h1 : (1 - ε) * p.2 ≤ p.2 := by nlinarith [(htP p hp).1]
    exact (htP p hp).2 (ball_subset_closedBall (ball_subset_ball h1 hzp))
  have hUm : MeasurableSet U := Finset.measurableSet_biUnion _ fun _ _ => measurableSet_ball
  have hUvol : volume.real U = (1 - ε) ^ m * T := by
    rw [hUdef, measureReal_biUnion_finset (fun p hp q hq hpq => by
      have h1 : (1 - ε) * p.2 ≤ p.2 := by nlinarith [(htP p hp).1]
      have h2 : (1 - ε) * q.2 ≤ q.2 := by nlinarith [(htP q hq).1]
      exact (htdisj hp hq hpq).mono (ball_subset_closedBall.trans (closedBall_subset_closedBall h1))
        (ball_subset_closedBall.trans (closedBall_subset_closedBall h2)))
      (fun _ _ => measurableSet_ball) (fun _ _ => measure_ball_lt_top.ne), hTdef, Finset.mul_sum]
    refine Finset.sum_congr rfl fun p hp => ?_
    have hr := (htP p hp).1
    rw [cv_measureReal_ball _ (mul_pos (by linarith) hr), hV p hp, ← mul_pow]
    ring_nf
  have hBU : volume.real (Ω \ U) = b - (1 - ε) ^ m * T := by
    rw [measureReal_sdiff hUB hUm hfin, hUvol, hbB]
  have hsum : ∑ p ∈ t, (2 * ((1 - ε) * p.2)) ^ m * I = (1 - ε) ^ m * T * I := by
    rw [hTdef, Finset.mul_sum, Finset.sum_mul]
    refine Finset.sum_congr rfl fun p hp => ?_
    rw [hV p hp, mul_pow, mul_pow, mul_pow]
    ring
  rw [hsum, hBU] at hΦle
  have hT0 : 0 ≤ T := Finset.sum_nonneg fun _ _ => measureReal_nonneg
  have := env_glue_estimate (m := m) hε0 hε1 hb hM0 hT0 (by linarith) (by linarith) hΦle
  linarith

/-- **Dacorogna's formula** (B. Dacorogna, J. Funct. Anal. 46 (1982), 102–118; D. Kinderlehrer and
P. Pedregal, Arch. Rational Mech. Anal. 115 (1991), 329–365, Proposition 8.1): for a continuous
`f : ℝ^{d×m} → ℝ`, every nonempty bounded open `Ω ⊆ ℝ^m` and every `A`,
`f^{qc} (A) = inf_φ ⨍_Ω f (A + ∇φ)` over the Lipschitz `φ` vanishing outside `Ω` (that is,
`φ ∈ W^{1,∞}_0 (Ω, ℝ^d)` extended by `0`), with values in `EReal`.

Kinderlehrer and Pedregal state the formula for continuous integrands that need not be bounded
below; Dacorogna proved it first. Neither proof was accessible; the argument used is the proof of
S. Müller, *Variational models for microstructure and phase transitions*, lecture notes, MPI MiS
Leipzig, 1998, Theorem 4.5 (iii), §4.8, with the unit cube `Q` as Müller's domain `U` and
`Qf = cubeInf f`:

* (a) `inf_Ω ≤ cubeInf f`, the covering half of "a simple scaling and covering argument shows that
  `Qf` is independent of `U`": rescaled copies of a cube test map glued into finitely many disjoint
  small cubes filling `Ω` up to `ε` (`env_iInf_le_cubeInf`);
* (b) "by the definition of quasiconvexity `Qf ≥ Qf^{qc} = f^{qc}`": an admissible `g ≤ f` is
  quasiconvex on `Ω` (`quasiconvexAtOn_iff`, Müller's Remark 2), so
  `g (A) ≤ ⨍_Ω g (A + ∇φ) ≤ ⨍_Ω f (A + ∇φ)` (`env_le_average`);
* (c) "it suffices to show that `Qf` is quasiconvex since `Qf ≤ f`" (`cubeInf_le`,
  `cubeInf_le_qcEnvelope`);
* (d) (4.28), `⨍_Q Qf (F + ∇ψ) ≥ Qf (F)` for piecewise affine `ψ`, by gluing almost minimisers on
  the pieces, the value `−∞` allowed (`cubeInf_le_sum_of_piecewiseAffine`), and with the laminates
  of Lemma 4.3 the two-point inequality along `a ⊗ e_j` (`cubeInf_le_two_point`);
* (e) hence `Qf` is convex in each entry and, when finite, locally Lipschitz, by Müller's Remark 3
  (`cubeInfReal_convexOn`, `cubeInfReal_continuous`);
* (f) "`Qf` is quasiconvex by (4.28) and density arguments": (4.28) for the Kuhn–Freudenthal
  interpolants of a test map and dominated convergence (`cubeInfReal_quasiconvex`);
* (g) if `Qf` takes the value `−∞`, the two-point inequality propagates it along the matrix units,
  and `Qf ≡ −∞` (`cubeInf_bot_line`, `cubeInf_bot_all`).

Müller states the formula for domains with `|∂U| = 0`; nothing here needs it: quasiconvexity on a
bounded open set is quasiconvexity on the cube (`quasiconvexAtOn_iff`), by the vanishing of the
gradient of a Lipschitz map almost everywhere on its zero set. -/
theorem qcEnvelope_eq_iInf {f : Matrix (Fin d) (Fin m) ℝ → ℝ} (hf : Continuous f)
    {Ω : Set (Fin m → ℝ)} (hΩ : IsOpen Ω) (hb : Bornology.IsBounded Ω) (hne : Ω.Nonempty)
    (A : Matrix (Fin d) (Fin m) ℝ) :
    qcEnvelope f A =
      ⨅ (φ : (Fin m → ℝ) → Fin d → ℝ) (_ : (∃ K, LipschitzWith K φ) ∧ ∀ x ∉ Ω, φ x = 0),
        (((volume Ω).toReal⁻¹ * ∫ x in Ω, f (A + grad φ x) : ℝ) : EReal) := by
  refine le_antisymm ?_ ((env_iInf_le_cubeInf hf hΩ (hΩ.measure_pos volume hne)
    hb.measure_lt_top.ne A).trans (cubeInf_le_qcEnvelope hf A))
  refine iSup₂_le fun g hg => le_iInf₂ fun φ hφ => ?_
  obtain ⟨hlsc, hbdd, hqc, hgf⟩ := hg
  exact EReal.coe_le_coe_iff.2 (env_le_average hlsc hbdd hqc hgf hf hΩ hb hne A hφ)

/-- **Dacorogna's formula on the unit ball**: for a continuous `f : ℝ^{d×m} → ℝ` and every `A`,
`f^{qc} (A) = inf_φ ⨍_{B} f (A + ∇φ)` over the Lipschitz `φ` vanishing outside the Euclidean unit
ball `B` (that is, `φ ∈ W^{1,∞}_0 (B, ℝ^d)` extended by `0`), with values in `EReal`: the case
`Ω = B` of `qcEnvelope_eq_iInf`. -/
theorem qcEnvelope_eq_iInf_unitBall {f : Matrix (Fin d) (Fin m) ℝ → ℝ} (hf : Continuous f)
    (A : Matrix (Fin d) (Fin m) ℝ) :
    qcEnvelope f A =
      ⨅ (φ : (Fin m → ℝ) → Fin d → ℝ) (_ : (∃ K, LipschitzWith K φ) ∧ ∀ x ∉ unitBall m, φ x = 0),
        (((volume (unitBall m)).toReal⁻¹ * ∫ x in unitBall m, f (A + grad φ x) : ℝ) : EReal) :=
  qcEnvelope_eq_iInf hf cv_unitBall_isOpen (isBounded_closedBall.subset cv_unitBall_subset)
    ⟨0, by simp [unitBall]⟩ A

end Domain

end CalculusOfVariations
