module

public import CalculusOfVariations.Envelope.Cube
public import CalculusOfVariations.Lipschitz.Rescale
public import Mathlib.MeasureTheory.Covering.Vitali

/-!
# The infimum formula does not depend on the domain

For a continuous `f : ℝ^{d×m} → ℝ` and a domain `Ω ⊆ ℝ^m`, `domainInf Ω f A = inf_φ ⨍_Ω f (A + ∇φ)`
over the Lipschitz `φ` vanishing outside `Ω`, with values in `EReal`. For bounded open sets with
null boundary it does not depend on `Ω` (`domainInf_eq`); more precisely,
`domainInf Ω f A ≤ domainInf D f A` for every nonempty open `Ω` of finite measure and every nonempty
bounded open `D` with `|∂D| = 0` (`domainInf_le_domainInf`).

This is (i) of Proposition 8.1 of D. Kinderlehrer and P. Pedregal, *Characterizations of Young
measures generated by gradients*, Arch. Rational Mech. Anal. 115 (1991), 329–365 ([KP], p. 361),
with its proof: by Vitali's covering theorem, up to a null set `Ω` is the union of countably many
disjoint copies `a_i + ε_i D̄` of `D̄`; the rescaled copies `ε_i ζ ((x − a_i) / ε_i)` of a test map
`ζ` on `D`, glued, give a test map `v` on `Ω` with `⨍_Ω f (A + ∇v) = ⨍_D f (A + ∇ζ)`
(`exists_testMap_setIntegral_eq`); then the roles of `Ω` and `D` are interchanged. The argument
needs `|∂D| = 0`, which [KP] do not state in the proposition (it is a hypothesis of their Theorem
2.1, whose covering argument they use): the sets `a_i + ε_i D`, on which `v` is defined by `ζ`,
cover `Ω` up to a null set only if the `a_i + ε_i ∂D` are null sets. No condition on `∂Ω` is needed
for the inequality `domainInf Ω f A ≤ domainInf D f A`.
-/

@[expose] public section

open MeasureTheory Metric Set Filter Topology

namespace CalculusOfVariations

variable {d m : ℕ}

/-- The infimum formula on `Ω`: `inf_φ ⨍_Ω f (A + ∇φ)` over the Lipschitz `φ` vanishing outside `Ω`
([KP], (8.1), where it is `φ^#_Ω`). -/
noncomputable def domainInf (Ω : Set (Fin m → ℝ)) (f : Matrix (Fin d) (Fin m) ℝ → ℝ)
    (A : Matrix (Fin d) (Fin m) ℝ) : EReal :=
  ⨅ (φ : (Fin m → ℝ) → Fin d → ℝ) (_ : (∃ K, LipschitzWith K φ) ∧ ∀ x ∉ Ω, φ x = 0),
    (((volume Ω).toReal⁻¹ * ∫ x in Ω, f (A + grad φ x) : ℝ) : EReal)

/-- The infimum formula on the unit cube is `cubeInf`. -/
theorem domainInf_unitCube (f : Matrix (Fin d) (Fin m) ℝ → ℝ) (A : Matrix (Fin d) (Fin m) ℝ) :
    domainInf (unitCube m) f A = cubeInf f A := by
  simp only [domainInf, cubeInf, IsCubeTestMap, cv_volume_unitCube, ENNReal.toReal_one, inv_one,
    one_mul]

/-! ### Gluing -/

/-- **Gluing.** Maps `w_i` that are `K`-Lipschitz and vanish outside the pairwise disjoint sets
`P_i` glue to a `2K`-Lipschitz map. -/
theorem exists_glue {ι : Type*} {P : ι → Set (Fin m → ℝ)}
    (hP : Pairwise (Function.onFun Disjoint P)) {w : ι → (Fin m → ℝ) → Fin d → ℝ} {K : NNReal}
    (hw : ∀ i, LipschitzWith K (w i)) (hw0 : ∀ i, ∀ x ∉ P i, w i x = 0) :
    ∃ v : (Fin m → ℝ) → Fin d → ℝ, LipschitzWith (2 * K) v ∧ (∀ i, ∀ x ∈ P i, v x = w i x) ∧
      ∀ x, (∀ i, x ∉ P i) → v x = 0 := by
  classical
  set v : (Fin m → ℝ) → Fin d → ℝ := fun x => if h : ∃ i, x ∈ P i then w h.choose x else 0 with hv
  have hv1 : ∀ i, ∀ x ∈ P i, v x = w i x := by
    intro i x hx
    have h : ∃ i, x ∈ P i := ⟨i, hx⟩
    have hi : h.choose = i := by
      by_contra hne
      exact Set.disjoint_left.1 (hP hne) h.choose_spec hx
    simp only [hv, h, dite_true, hi]
  have hv0 : ∀ x, (∀ i, x ∉ P i) → v x = 0 := by
    intro x hx
    have h : ¬ ∃ i, x ∈ P i := fun ⟨i, hi⟩ => hx i hi
    simp only [hv, h, dite_false]
  have hd : ∀ i x y, ‖w i x - w i y‖ ≤ K * dist x y := fun i x y => by
    rw [← dist_eq_norm]; exact (hw i).dist_le_mul x y
  have hK : ∀ x y : Fin m → ℝ, 0 ≤ (K : ℝ) * dist x y := fun x y => by positivity
  refine ⟨v, LipschitzWith.of_dist_le_mul fun x y => ?_, hv1, hv0⟩
  rw [dist_eq_norm]
  push_cast
  by_cases hx : ∃ i, x ∈ P i
  · obtain ⟨i, hi⟩ := hx
    rw [hv1 i x hi]
    by_cases hy : ∃ j, y ∈ P j
    · obtain ⟨j, hj⟩ := hy
      rw [hv1 j y hj]
      by_cases hij : i = j
      · subst hij
        linarith [hd i x y, hK x y]
      · -- `w_i (y) = 0` and `w_j (x) = 0`
        have hyi : w i y = 0 := hw0 i y fun h => Set.disjoint_left.1 (hP hij) h hj
        have hxj : w j x = 0 := hw0 j x fun h => Set.disjoint_left.1 (hP hij) hi h
        calc ‖w i x - w j y‖ = ‖(w i x - w i y) + (w j x - w j y)‖ := by
              rw [hyi, hxj]; congr 1; abel
          _ ≤ ‖w i x - w i y‖ + ‖w j x - w j y‖ := norm_add_le _ _
          _ ≤ 2 * K * dist x y := by linarith [hd i x y, hd j x y]
    · have hy' : ∀ j, y ∉ P j := fun j hj => hy ⟨j, hj⟩
      rw [hv0 y hy', ← hw0 i y (hy' i)]
      linarith [hd i x y, hK x y]
  · have hx' : ∀ i, x ∉ P i := fun i hi => hx ⟨i, hi⟩
    rw [hv0 x hx']
    by_cases hy : ∃ j, y ∈ P j
    · obtain ⟨j, hj⟩ := hy
      rw [hv1 j y hj, ← hw0 j x (hx' j)]
      linarith [hd j x y, hK x y]
    · rw [hv0 y fun j hj => hy ⟨j, hj⟩, sub_zero, norm_zero]
      linarith [hK x y]

/-! ### The Vitali covering -/

/-- The volume of the copy `c + s E` of `E`. -/
theorem volume_preimage_affine (E : Set (Fin m → ℝ)) (c : Fin m → ℝ) {s : ℝ} (hs : 0 < s) :
    volume ((fun y => s⁻¹ • (y - c)) ⁻¹' E) = ENNReal.ofReal (s ^ m) * volume E := by
  have e : (fun y : Fin m → ℝ => s⁻¹ • (y - c)) ⁻¹' E =
      (fun y => y - c) ⁻¹' ((fun y => s⁻¹ • y) ⁻¹' E) := rfl
  rw [e]
  simp only [sub_eq_add_neg]
  rw [measure_preimage_add_right, Measure.addHaar_preimage_smul volume (inv_pos.2 hs).ne',
    Module.finrank_fin_fun, inv_pow, inv_inv, abs_of_pos (pow_pos hs m)]

/-- **The copies of a test map** ([KP], proof of Proposition 8.1 (i)). Let `Ω` be open with finite
measure, `D` bounded, open and nonempty with `|∂D| = 0`, and `ζ` a test map on `D`. Then there is a
test map `v` on `Ω` with `⨍_Ω f (A + ∇v) = ⨍_D f (A + ∇ζ)` for every continuous `f` and every `A`
(`v` depends only on `ζ`): by Vitali's covering theorem, `Ω` is up to a null set the union of
countably many disjoint `a_i + ε_i D̄`, hence of the `a_i + ε_i D`, and
`v (x) = ε_i ζ ((x − a_i) / ε_i)` on `a_i + ε_i D`, `v = 0` elsewhere. The change of variables on
every copy gives `∫_Ω f (A + ∇v) = (∑ ε_i^m) ∫_D f (A + ∇ζ)`, and `∑ ε_i^m |D| = |Ω|`, the case
`f = 1`. -/
theorem exists_testMap_setIntegral_eq {Ω D : Set (Fin m → ℝ)} (hΩ : IsOpen Ω)
    (hΩf : volume Ω ≠ ⊤) (hD : IsOpen D) (hDb : Bornology.IsBounded D) (hDne : D.Nonempty)
    (hD0 : volume (frontier D) = 0) {ζ : (Fin m → ℝ) → Fin d → ℝ} {K : NNReal}
    (hζ : LipschitzWith K ζ) (hζ0 : ∀ x ∉ D, ζ x = 0) :
    ∃ v : (Fin m → ℝ) → Fin d → ℝ, LipschitzWith (2 * K) v ∧ (∀ x ∉ Ω, v x = 0) ∧
      ∀ f : Matrix (Fin d) (Fin m) ℝ → ℝ, Continuous f → ∀ A,
        ∫ x in Ω, f (A + grad v x) =
          (volume Ω).toReal * ((volume D).toReal⁻¹ * ∫ x in D, f (A + grad ζ x)) := by
  obtain ⟨p, hp⟩ := hDne
  have hDfin : volume D ≠ ⊤ := hDb.measure_lt_top.ne
  have hDpos : volume D ≠ 0 := (hD.measure_pos volume ⟨p, hp⟩).ne'
  have hcl : volume (closure D) = volume D := by
    refine le_antisymm ?_ (measure_mono subset_closure)
    rw [closure_eq_self_union_frontier]
    exact (measure_union_le _ _).trans (by rw [hD0, add_zero])
  -- a ball containing `D̄`
  obtain ⟨R, hR0, hR⟩ : ∃ R : ℝ, 0 < R ∧ closure D ⊆ closedBall p R := by
    obtain ⟨R, hR⟩ := hDb.closure.subset_closedBall p
    exact ⟨max R 1, lt_max_of_lt_right one_pos,
      hR.trans (closedBall_subset_closedBall (le_max_left _ _))⟩
  -- the copies of `D̄` and of `D`; in the copy of index `(x, ε)`, `x` is the image of `p`
  set c : (Fin m → ℝ) × ℝ → Fin m → ℝ := fun q => q.1 - q.2 • p with hc
  set B : (Fin m → ℝ) × ℝ → Set (Fin m → ℝ) := fun q => (fun y => q.2⁻¹ • (y - c q)) ⁻¹' closure D
  set P : (Fin m → ℝ) × ℝ → Set (Fin m → ℝ) := fun q => (fun y => q.2⁻¹ • (y - c q)) ⁻¹' D
  have hcont : ∀ q : (Fin m → ℝ) × ℝ, Continuous fun y : Fin m → ℝ => q.2⁻¹ • (y - c q) :=
    fun q => by fun_prop
  have hPo : ∀ q, IsOpen (P q) := fun q => hD.preimage (hcont q)
  have hPB : ∀ q, P q ⊆ B q := fun q => preimage_mono subset_closure
  set t : Set ((Fin m → ℝ) × ℝ) := {q | q.1 ∈ Ω ∧ 0 < q.2 ∧ closedBall q.1 (q.2 * R) ⊆ Ω} with ht
  have hBball : ∀ q ∈ t, B q ⊆ closedBall q.1 (q.2 * R) := by
    rintro q ⟨-, hq, -⟩ y hy
    have h1 : q.2⁻¹ • (y - c q) ∈ closedBall p R := hR hy
    have e : q.2⁻¹ • (y - c q) - p = q.2⁻¹ • (y - q.1) := by
      simp only [hc]
      rw [smul_sub, smul_sub, smul_sub, inv_smul_smul₀ hq.ne']
      abel
    rw [mem_closedBall, dist_eq_norm, e, norm_smul, Real.norm_of_nonneg (inv_pos.2 hq).le,
      inv_mul_le_iff₀ hq] at h1
    rwa [mem_closedBall, dist_eq_norm]
  -- the covering
  obtain ⟨u, hut, hucount, hudisj, hucov⟩ := Vitali.exists_disjoint_covering_ae volume Ω t
    (ENNReal.ofReal ((6 * R) ^ m) / volume D).toNNReal (fun q => q.2 * R) (fun q => q.1) B hBball
    (by
      rintro q ⟨-, hq, -⟩
      have hC : ENNReal.ofReal ((6 * R) ^ m) / volume D ≠ ⊤ :=
        ENNReal.div_ne_top ENNReal.ofReal_ne_top hDpos
      rw [ENNReal.coe_toNNReal hC, volume_preimage_affine _ _ hq, hcl,
        Real.volume_pi_closedBall _ (by positivity), Fintype.card_fin,
        mul_comm (ENNReal.ofReal (q.2 ^ m)), ← mul_assoc (_ / _),
        ENNReal.div_mul_cancel hDpos hDfin, ← ENNReal.ofReal_mul (by positivity), ← mul_pow]
      exact ENNReal.ofReal_le_ofReal (le_of_eq (by ring)))
    (by
      rintro q ⟨-, hq, -⟩
      refine ⟨q.1, interior_maximal (hPB q) (hPo q) ?_⟩
      show q.2⁻¹ • (q.1 - (q.1 - q.2 • p)) ∈ D
      rwa [sub_sub_cancel, inv_smul_smul₀ hq.ne'])
    (fun q _ => isClosed_closure.preimage (hcont q))
    (by
      intro x hx ε hε
      obtain ⟨ρ, hρ, hball⟩ := Metric.isOpen_iff.1 hΩ x hx
      have hm : 0 < min (ε / R) (ρ / (2 * R)) := by positivity
      refine ⟨(x, min (ε / R) (ρ / (2 * R))), ⟨hx, hm, ?_⟩, ?_, rfl⟩
      · refine (closedBall_subset_ball ?_).trans hball
        calc min (ε / R) (ρ / (2 * R)) * R ≤ ρ / (2 * R) * R := by
              gcongr; exact min_le_right _ _
          _ = ρ / 2 := by field_simp
          _ < ρ := by linarith
      · calc min (ε / R) (ρ / (2 * R)) * R ≤ ε / R * R := by gcongr; exact min_le_left _ _
          _ = ε := div_mul_cancel₀ _ hR0.ne')
  have hu : ∀ q : u, 0 < q.1.2 := fun q => (hut q.2).2.1
  have : Countable u := hucount.to_subtype
  have hPd : Pairwise (Function.onFun Disjoint fun q : u => P q) := fun q q' hne =>
    (hudisj q.2 q'.2 fun h => hne (Subtype.ext h)).mono (hPB q) (hPB q')
  -- the glued map
  obtain ⟨v, hv, hvP, hv0⟩ := exists_glue hPd (w := fun q : u => rescaleMap ζ (c q) q.1.2)
    (fun q => rescaleMap_lipschitz hζ (c q) (hu q)) (fun q x hx => rescaleMap_eq_zero hζ0 _ _ hx)
  have hPΩ : ∀ q : u, P q ⊆ Ω := fun q =>
    (hPB q).trans ((hBball q (hut q.2)).trans (hut q.2).2.2)
  refine ⟨v, hv, fun x hx => hv0 x fun q hq => hx (hPΩ q hq), ?_⟩
  -- the copies of `D` cover `Ω` up to a null set
  have hcov : Ω =ᵐ[volume] ⋃ q : u, P q := by
    refine ae_eq_set.2 ⟨?_, by rw [sdiff_eq_empty.2 (iUnion_subset hPΩ), measure_empty]⟩
    refine measure_mono_null (t := (Ω \ ⋃ q ∈ u, B q) ∪ ⋃ q : u, (B q \ P q)) ?_
      (measure_union_null hucov (measure_iUnion_null fun q => ?_))
    · rintro x ⟨hxΩ, hx⟩
      by_cases hxB : x ∈ ⋃ q ∈ u, B q
      · obtain ⟨q, hq, hxq⟩ := mem_iUnion₂.1 hxB
        exact Or.inr (mem_iUnion.2 ⟨⟨q, hq⟩, hxq, fun h => hx (mem_iUnion.2 ⟨⟨q, hq⟩, h⟩)⟩)
      · exact Or.inl ⟨hxΩ, hxB⟩
    · have e : B q \ P q = (fun y => q.1.2⁻¹ • (y - c q)) ⁻¹' frontier D := by
        rw [← preimage_sdiff, hD.frontier_eq]
      rw [e, volume_preimage_affine _ _ (hu q), hD0, mul_zero]
  -- the energy of the copies
  have key : ∀ f : Matrix (Fin d) (Fin m) ℝ → ℝ, Continuous f → ∀ A,
      ∫ x in Ω, f (A + grad v x) = (∑' q : u, q.1.2 ^ m) * ∫ x in D, f (A + grad ζ x) := by
    intro f hf A
    have hfin : volume (⋃ q : u, P q) ≠ ⊤ := by rwa [← measure_congr hcov]
    rw [setIntegral_congr_set hcov, integral_iUnion (s := fun q : u => P q)
      (fun q => (hPo q).measurableSet) hPd (cv_integrableOn hf A hv hfin), ← tsum_mul_right]
    refine tsum_congr fun q => ?_
    have h1 : ∀ x ∈ P q, f (A + grad v x) =
        (fun y => f (A + grad ζ y)) (q.1.2⁻¹ • (x - c q)) := fun x hx => by
      have hev : v =ᶠ[𝓝 x] rescaleMap ζ (c q) q.1.2 := by
        filter_upwards [(hPo q).mem_nhds hx] with y hy using hvP q y hy
      rw [cv_grad_congr hev, rescaleMap_grad _ _ (hu q).ne']
    rw [setIntegral_congr_fun (hPo q).measurableSet h1, ← integral_indicator (hPo q).measurableSet,
      ← integral_indicator hD.measurableSet]
    have hind : (P q).indicator (fun x => (fun y => f (A + grad ζ y)) (q.1.2⁻¹ • (x - c q))) =
        fun x => D.indicator (fun y => f (A + grad ζ y)) (q.1.2⁻¹ • (x - c q)) := by
      ext x
      simp only [Set.indicator]
      rfl
    rw [hind, cv_integral_comp_affine _ (c q) (hu q)]
  intro f hf A
  -- `∑ ε_i^m |D| = |Ω|`
  have hone := key (fun _ => 1) continuous_const 0
  simp only [setIntegral_const, smul_eq_mul, mul_one] at hone
  have hDr : (volume D).toReal ≠ 0 := ENNReal.toReal_ne_zero.2 ⟨hDpos, hDfin⟩
  rw [key f hf A, ← mul_assoc]
  congr 1
  rw [measureReal_def, measureReal_def] at hone
  rw [hone, mul_inv_cancel_right₀ hDr]

/-- **[KP], Proposition 8.1 (i)**: the infimum formula on a nonempty open `Ω` of finite measure is
at most the one on a nonempty bounded open `D` with `|∂D| = 0`. -/
theorem domainInf_le_domainInf {f : Matrix (Fin d) (Fin m) ℝ → ℝ} (hf : Continuous f)
    {Ω D : Set (Fin m → ℝ)} (hΩ : IsOpen Ω) (hΩf : volume Ω ≠ ⊤) (hΩne : Ω.Nonempty)
    (hD : IsOpen D) (hDb : Bornology.IsBounded D) (hDne : D.Nonempty)
    (hD0 : volume (frontier D) = 0) (A : Matrix (Fin d) (Fin m) ℝ) :
    domainInf Ω f A ≤ domainInf D f A := by
  refine le_iInf₂ fun ζ hζ => ?_
  obtain ⟨⟨K, hK⟩, hζ0⟩ := hζ
  obtain ⟨v, hv, hv0, hvf⟩ := exists_testMap_setIntegral_eq hΩ hΩf hD hDb hDne hD0 hK hζ0
  refine (iInf₂_le v ⟨⟨_, hv⟩, hv0⟩).trans (EReal.coe_le_coe_iff.2 (le_of_eq ?_))
  have hr : (volume Ω).toReal ≠ 0 :=
    ENNReal.toReal_ne_zero.2 ⟨(hΩ.measure_pos volume hΩne).ne', hΩf⟩
  rw [hvf f hf A, inv_mul_cancel_left₀ hr]

/-- **[KP], Proposition 8.1 (i)**: the infimum formula does not depend on the domain, among the
nonempty bounded open sets with null boundary. (By `qcEnvelope_eq_iInf` the same holds without the
condition on the boundaries.) -/
theorem domainInf_eq {f : Matrix (Fin d) (Fin m) ℝ → ℝ} (hf : Continuous f)
    {Ω D : Set (Fin m → ℝ)} (hΩ : IsOpen Ω) (hΩb : Bornology.IsBounded Ω) (hΩne : Ω.Nonempty)
    (hΩ0 : volume (frontier Ω) = 0) (hD : IsOpen D) (hDb : Bornology.IsBounded D)
    (hDne : D.Nonempty) (hD0 : volume (frontier D) = 0) (A : Matrix (Fin d) (Fin m) ℝ) :
    domainInf Ω f A = domainInf D f A :=
  le_antisymm
    (domainInf_le_domainInf hf hΩ hΩb.measure_lt_top.ne hΩne hD hDb hDne hD0 A)
    (domainInf_le_domainInf hf hD hDb.measure_lt_top.ne hDne hΩ hΩb hΩne hΩ0 A)

end CalculusOfVariations
