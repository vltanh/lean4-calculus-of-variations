module

public import CalculusOfVariations.Envelope.Domain
public import CalculusOfVariations.Quasiconvex.Laminate
public import Mathlib.Data.EReal.Inv

/-!
# The infimum formula is rank-one convex

For a continuous `f`, the infimum formula `cubeInf f` on the unit cube `Q`, with values in `EReal`,
satisfies the two-point inequality
`cubeInf f (F) ≤ λ cubeInf f (F + (1 − λ) a ⊗ n) + (1 − λ) cubeInf f (F − λ a ⊗ n)` in every
rank-one direction (`cubeInf_le_two_point_vecMulVec`). This is (ii) of Proposition 8.1 of D.
Kinderlehrer and P. Pedregal, *Characterizations of Young measures generated by gradients*, Arch.
Rational Mech. Anal. 115 (1991), 329–365 ([KP], p. 361–362), with its proof, the method of M. Chipot
and D. Kinderlehrer, *Equilibrium configurations of crystals*, Arch. Rational Mech. Anal. 103
(1988), 237–277, Lemma 3.3 (the citation is [KP]'s). In [KP] `F` stands for `F − λ a ⊗ n` and `b`
for `n`:

* Let `D` be a unit cube with a face orthogonal to `n`, `∇u^k = F − λ a ⊗ n + χ_k a ⊗ n` with `χ_k`
  the characteristic function of `{x : fract (k x · n) < λ}`, so `u^k → y = F x` uniformly; and
  `η^k` cut-off functions, `η^k = 1` on a subcube `D^k`, `|D ∖ D^k| → 0`, such that the gradients of
  `v^k = y + η^k (u^k − y)` are bounded. Here first for `n = e_j`, `D = Q`: `u^k − y` is
  `sawLaminate`, `η^k = rd_eta (1/k)`, `D^k = (1/k, 1 − 1/k)^m` (`rd_inner`); [KP] choose a
  subsequence of the `k`, here the frequency of the laminate is `k` as well, so that
  `|∇η^k| |u^k − y| ≤ m |a|`.
* With `D^k_0 = {x ∈ D^k : χ_k = 0}` and `D^k_1 = {x ∈ D^k : χ_k = 1}`, whose measures tend to
  `1 − λ` and `λ`, and a Lipschitz `ζ` with support in `D^k` and `ζ = 0` on `∂D^k_0 ∪ ∂D^k_1`,
  `φ^# (F)` is at most `∫_D φ (∇v^k + ∇ζ)`, which is the sum of `∫_{D^k_0} φ (F − λ a ⊗ n + ∇ζ)`, of
  `∫_{D^k_1} φ (F + (1 − λ) a ⊗ n + ∇ζ)` and of `ε_k = ∫_{D ∖ D^k} φ (∇v^k)`, `ε_k → 0`. Varying `ζ`
  independently in `D^k_0` and `D^k_1`,
  `φ^# (F) ≤ |D^k_0| φ^# (F − λ a ⊗ n) + |D^k_1| φ^# (F + (1 − λ) a ⊗ n) + ε_k`, by the independence
  of the domain (i), and `k → ∞`. Here `ζ` is the sum of copies of given test maps `ζ_0`, `ζ_1` on
  `Q` in `D^k_0` and `D^k_1` (`exists_testMap_setIntegral_eq`), which gives
  `cubeInf f F ≤ (1 − λ) ∫_Q f (F − λ a ⊗ e_j + ∇ζ_0) + λ ∫_Q f (F + (1 − λ) a ⊗ e_j + ∇ζ_1)`
  (`rc_le_slabs`); then the infimum over `ζ_0`, `ζ_1`, the value `−∞` allowed
  (`cubeInf_le_two_point`).
* The cube `D` with a face orthogonal to a unit vector `n` is `R Q` for an orthogonal `R` with
  `R e_j = n`: `cubeInf f F` is the infimum formula on `R Q` by the independence of the domain (i),
  and the change of variables `x = R y` makes it the infimum formula on `Q` of `X ↦ f (X Rᵀ)` at
  `F R` (`cubeInf_comp_orthogonal`).
-/

@[expose] public section

open MeasureTheory Metric Set Filter Topology
open scoped Matrix

namespace CalculusOfVariations

variable {d m : ℕ}

/-! ### The slabs of the laminate -/

/-- The slabs `{x : α < fract (k x_j) < β}`. -/
private def rcSlab (j : Fin m) (k : ℕ) (α β : ℝ) : Set (Fin m → ℝ) :=
  {x | α < Int.fract ((k : ℝ) * x j) ∧ Int.fract ((k : ℝ) * x j) < β}

private lemma rc_isOpen_slab (j : Fin m) (k : ℕ) {α β : ℝ} (hα : 0 ≤ α) (hβ : β ≤ 1) :
    IsOpen (rcSlab j k α β) := by
  have e : {t : ℝ | α < Int.fract t ∧ Int.fract t < β} = ⋃ n : ℤ, Ioo (n + α) (n + β) := by
    ext t
    simp only [mem_ofPred_eq, mem_iUnion, mem_Ioo]
    constructor
    · rintro ⟨h1, h2⟩
      have := Int.floor_add_fract t
      exact ⟨⌊t⌋, by linarith, by linarith⟩
    · rintro ⟨n, h1, h2⟩
      have hf : Int.fract t = t - n := by
        rw [← Int.self_sub_floor, Int.floor_eq_iff.2 ⟨by linarith, by linarith⟩]
      rw [hf]
      constructor <;> linarith
  have ho : IsOpen {t : ℝ | α < Int.fract t ∧ Int.fract t < β} := by
    rw [e]; exact isOpen_iUnion fun n => isOpen_Ioo
  have hc : Continuous fun x : Fin m → ℝ => (k : ℝ) * x j := by fun_prop
  exact ho.preimage hc

/-- The slabs where `∇u^k = F + (1 − λ) a ⊗ e_j` and `∇u^k = F − λ a ⊗ e_j` have the measures `λ`
and `1 − λ` in the unit cube. -/
private lemma rc_volume_slab (j : Fin m) {l : ℝ} (hl0 : 0 < l) (hl1 : l < 1) {k : ℕ} (hk : 0 < k) :
    volume.real (rcSlab j k 0 l ∩ unitCube m) = l ∧
      volume.real (rcSlab j k l 1 ∩ unitCube m) = 1 - l := by
  have hS1 : MeasurableSet (rcSlab j k 0 l) := (rc_isOpen_slab j k le_rfl hl1.le).measurableSet
  have hS0 : MeasurableSet (rcSlab j k l 1) := (rc_isOpen_slab j k hl0.le le_rfl).measurableSet
  have h1 := lam_setIntegral_fract j hl0 hl1 hk 1 0
  have h0 := lam_setIntegral_fract j hl0 hl1 hk 0 1
  rw [mul_one, mul_zero, add_zero] at h1
  rw [mul_zero, mul_one, zero_add] at h0
  constructor
  · rw [← measureReal_restrict_apply hS1, ← integral_indicator_one hS1]
    refine (integral_congr_ae (ae_restrict_of_ae ?_)).trans h1
    filter_upwards [lam_ae_fract_ne j hk 0] with x hx
    have hx' : 0 < Int.fract ((k : ℝ) * x j) := lt_of_le_of_ne (Int.fract_nonneg _) (Ne.symm hx)
    by_cases h : Int.fract ((k : ℝ) * x j) < l
    · rw [indicator_of_mem (show x ∈ rcSlab j k 0 l from ⟨hx', h⟩), ite_eq_left h, Pi.one_apply]
    · rw [indicator_of_notMem (fun hx'' : x ∈ rcSlab j k 0 l => h hx''.2), ite_eq_right h]
  · rw [← measureReal_restrict_apply hS0, ← integral_indicator_one hS0]
    refine (integral_congr_ae (ae_restrict_of_ae ?_)).trans h0
    filter_upwards [lam_ae_fract_ne j hk l] with x hx
    by_cases h : Int.fract ((k : ℝ) * x j) < l
    · rw [indicator_of_notMem (fun hx' : x ∈ rcSlab j k l 1 => lt_asymm h hx'.1), ite_eq_left h]
    · have hx' : l < Int.fract ((k : ℝ) * x j) := lt_of_le_of_ne (not_lt.1 h) (Ne.symm hx)
      rw [indicator_of_mem (show x ∈ rcSlab j k l 1 from ⟨hx', Int.fract_lt_one _⟩),
        ite_eq_right h, Pi.one_apply]

/-! ### Independent test maps on the slabs -/

/-- [KP], Proposition 8.1 (ii), for given test maps `ζ₁`, `ζ₀` on the unit cube and the direction
`a ⊗ e_j`: with copies of `ζ₁` in `D^k_1` and of `ζ₀` in `D^k_0` added to the cut-off laminate
`v^k`, `cubeInf f F ≤ |D^k_1| I₁ + |D^k_0| I₀ + ε_k`, where `I₁ = ∫_Q f (F + (1 − λ) a ⊗ e_j + ∇ζ₁)`
and `I₀ = ∫_Q f (F − λ a ⊗ e_j + ∇ζ₀)`; and `k → ∞`. -/
private theorem rc_le_slabs {f : Matrix (Fin d) (Fin m) ℝ → ℝ} (hf : Continuous f)
    (F : Matrix (Fin d) (Fin m) ℝ) (a : Fin d → ℝ) (j : Fin m) {l : ℝ} (hl0 : 0 < l) (hl1 : l < 1)
    {ζ₁ ζ₀ : (Fin m → ℝ) → Fin d → ℝ} (h₁ : IsCubeTestMap ζ₁) (h₀ : IsCubeTestMap ζ₀) :
    cubeInf f F ≤ ((l * (∫ x in unitCube m,
        f (F + (1 - l) • Matrix.vecMulVec a (Pi.single j 1) + grad ζ₁ x)) +
      (1 - l) * ∫ x in unitCube m,
        f (F - l • Matrix.vecMulVec a (Pi.single j 1) + grad ζ₀ x) : ℝ) : EReal) := by
  set A₁ := F + (1 - l) • Matrix.vecMulVec a (Pi.single j (1 : ℝ)) with hA₁
  set A₀ := F - l • Matrix.vecMulVec a (Pi.single j (1 : ℝ)) with hA₀
  set I₁ := ∫ x in unitCube m, f (A₁ + grad ζ₁ x) with hI₁
  set I₀ := ∫ x in unitCube m, f (A₀ + grad ζ₀ x) with hI₀
  obtain ⟨⟨K₁, hK₁⟩, hζ₁⟩ := h₁
  obtain ⟨⟨K₀, hK₀⟩, hζ₀⟩ := h₀
  have hQm : MeasurableSet (unitCube m) := cv_measurableSet_unitCube
  have hQfin : volume (unitCube m) ≠ ⊤ := by rw [cv_volume_unitCube]; exact ENNReal.one_ne_top
  have hQ1 : volume.real (unitCube m) = 1 := by
    rw [measureReal_def, cv_volume_unitCube, ENNReal.toReal_one]
  have hQne : (unitCube m).Nonempty := ⟨fun _ => 1 / 2, fun _ _ => ⟨by norm_num, by norm_num⟩⟩
  have hQb : Bornology.IsBounded (unitCube m) :=
    isBounded_closedBall.subset cv_unitCube_subset_closedBall
  have hQ0 : volume (frontier (unitCube m)) = 0 :=
    Convex.addHaar_frontier volume (convex_pi fun _ _ => convex_Ioo 0 1)
  -- the bound of `f` on the gradients of the cut-off laminates
  obtain ⟨C, hC0, hC⟩ := cv_bdd hf F ((‖a‖₊ + m * ‖a‖₊ : NNReal) : ℝ)
  -- the inequality for the index `k`
  have key : ∀ k : ℕ, 2 ≤ k → cubeInf f F ≤ ((l * I₁ + (1 - l) * I₀ +
      (|I₁| + |I₀| + 2 * C) * (1 - (1 - 2 * (1 / (k : ℝ))) ^ m) : ℝ) : EReal) := by
    intro k hk
    have hk0 : 0 < k := by omega
    have hk' : (2 : ℝ) ≤ k := by exact_mod_cast hk
    set δ : ℝ := 1 / k with hδdef
    have hδ : 0 < δ := by positivity
    have hδ2 : 2 * δ ≤ 1 := by rw [hδdef, mul_one_div, div_le_one (by linarith)]; exact hk'
    set lay : ℝ := 1 - (1 - 2 * δ) ^ m with hlay
    have hlayer : volume.real (unitCube m \ rd_inner δ) = lay := rd_volume_real_layer hδ.le hδ2
    have hlay0 : 0 ≤ lay := hlayer ▸ measureReal_nonneg
    -- `D^k_1` and `D^k_0`
    set D₁ := rd_inner δ ∩ rcSlab j k 0 l with hD₁
    set D₀ := rd_inner δ ∩ rcSlab j k l 1 with hD₀
    have hD₁o : IsOpen D₁ := (rd_inner_isOpen δ).inter (rc_isOpen_slab j k le_rfl hl1.le)
    have hD₀o : IsOpen D₀ := (rd_inner_isOpen δ).inter (rc_isOpen_slab j k hl0.le le_rfl)
    have hD₁Q : D₁ ⊆ unitCube m := inter_subset_left.trans (rd_inner_subset hδ.le)
    have hD₀Q : D₀ ⊆ unitCube m := inter_subset_left.trans (rd_inner_subset hδ.le)
    have hdisj : Disjoint D₁ D₀ := Set.disjoint_left.2 fun x hx hx' =>
      lt_asymm hx.2.2 hx'.2.1
    have hD₁f : volume D₁ ≠ ⊤ := ne_top_of_le_ne_top hQfin (measure_mono hD₁Q)
    have hD₀f : volume D₀ ≠ ⊤ := ne_top_of_le_ne_top hQfin (measure_mono hD₀Q)
    -- their measures
    obtain ⟨hS₁, hS₀⟩ := rc_volume_slab (m := m) j hl0 hl1 hk0
    have hmeas : ∀ α β, MeasurableSet (rcSlab j k α β) → volume.real (rd_inner δ ∩ rcSlab j k α β) ≤
        volume.real (rcSlab j k α β ∩ unitCube m) ∧ volume.real (rcSlab j k α β ∩ unitCube m) ≤
        volume.real (rd_inner δ ∩ rcSlab j k α β) + lay := by
      intro α β hS
      constructor
      · refine measureReal_mono (fun x hx => ⟨hx.2, rd_inner_subset hδ.le hx.1⟩)
          (ne_top_of_le_ne_top hQfin (measure_mono inter_subset_right))
      · rw [← hlayer]
        refine (measureReal_mono (fun x hx => ?_) ?_).trans (measureReal_union_le _ _)
        · by_cases hxi : x ∈ rd_inner δ
          · exact Or.inl ⟨hxi, hx.1⟩
          · exact Or.inr ⟨hx.2, hxi⟩
        · exact (measure_union_lt_top ((measure_mono (inter_subset_left.trans
            (rd_inner_subset hδ.le))).trans_lt hQfin.lt_top) ((measure_mono
            sdiff_subset).trans_lt hQfin.lt_top)).ne
    obtain ⟨hm₁, hm₁'⟩ := hmeas 0 l (rc_isOpen_slab j k le_rfl hl1.le).measurableSet
    obtain ⟨hm₀, hm₀'⟩ := hmeas l 1 (rc_isOpen_slab j k hl0.le le_rfl).measurableSet
    rw [hS₁] at hm₁ hm₁'
    rw [hS₀] at hm₀ hm₀'
    -- the copies of `ζ₁` and `ζ₀`
    obtain ⟨v₁, hv₁, hv₁0, hv₁f⟩ := exists_testMap_setIntegral_eq hD₁o hD₁f cv_isOpen_unitCube hQb
      hQne hQ0 hK₁ hζ₁
    obtain ⟨v₀, hv₀, hv₀0, hv₀f⟩ := exists_testMap_setIntegral_eq hD₀o hD₀f cv_isOpen_unitCube hQb
      hQne hQ0 hK₀ hζ₀
    -- the cut-off laminate
    set ψ : (Fin m → ℝ) → Fin d → ℝ := fun x => rd_eta δ x • sawLaminate a j l k x with hψdef
    have hψ : LipschitzWith (‖a‖₊ + m * ‖a‖₊) ψ :=
      rd_eta_smul_lipschitz (sawLaminate_lipschitz a j hl0.le hl1.le k) hδ fun x => by
        rw [coe_nnnorm, hδdef, one_div, mul_comm]
        exact sawLaminate_norm_le a j hl0.le k x
    have hψ0 : ∀ x ∉ unitCube m, ψ x = 0 := fun x hx => by
      simp only [hψdef, rd_eta_zero hδ hx, zero_smul]
    -- the test map
    set Φ : (Fin m → ℝ) → Fin d → ℝ := ψ + (v₁ + v₀) with hΦdef
    have hΦ : LipschitzWith (‖a‖₊ + m * ‖a‖₊ + (2 * K₁ + 2 * K₀)) Φ := hψ.add (hv₁.add hv₀)
    have hΦ0 : ∀ x ∉ unitCube m, Φ x = 0 := fun x hx => by
      simp only [hΦdef, Pi.add_apply, hψ0 x hx, hv₁0 x fun h => hx (hD₁Q h),
        hv₀0 x fun h => hx (hD₀Q h), add_zero]
    have hint : IntegrableOn (fun x => f (F + grad Φ x)) (unitCube m) :=
      cv_integrableOn hf F hΦ hQfin
    -- its gradient
    have hgrad : ∀ᵐ x : Fin m → ℝ, grad Φ x = grad ψ x + (grad v₁ x + grad v₀ x) := by
      filter_upwards [hψ.ae_differentiableAt (μ := volume), hv₁.ae_differentiableAt (μ := volume),
        hv₀.ae_differentiableAt (μ := volume)] with x h1 h2 h3
      rw [hΦdef, cv_grad_add h1 (h2.add h3), cv_grad_add h2 h3]
    have hgψ : ∀ x ∈ rd_inner δ, grad ψ x = grad (sawLaminate a j l k) x := fun x hx => by
      refine cv_grad_congr ?_
      filter_upwards [(rd_inner_isOpen δ).mem_nhds hx] with y hy
      simp only [hψdef, rd_eta_one hδ hy, one_smul]
    -- the energies on `D^k_1`, `D^k_0` and the rest
    have hE₁ : ∫ x in D₁, f (F + grad Φ x) = volume.real D₁ * I₁ := by
      have e : ∫ x in D₁, f (F + grad Φ x) = ∫ x in D₁, f (A₁ + grad v₁ x) := by
        refine setIntegral_congr_ae hD₁o.measurableSet ?_
        filter_upwards [hgrad, rd_ae_grad_eq_zero hv₀, lam_ae_hasFDerivAt_sawPart j hk0 hl0 hl1]
          with x h1 h2 h3 hx
        have hx0 : v₀ x = 0 := hv₀0 x fun h => Set.disjoint_left.1 hdisj hx h
        have e1 : grad (sawLaminate a j l k) x = _ := lam_grad_smul_of_hasFDerivAt a h3
        rw [h1, h2 hx0, hgψ x hx.1, e1, ite_eq_left hx.2.2, add_zero, hA₁, add_assoc]
      rw [e, hv₁f f hf A₁, cv_volume_unitCube, ENNReal.toReal_one, inv_one, one_mul,
        measureReal_def]
    have hE₀ : ∫ x in D₀, f (F + grad Φ x) = volume.real D₀ * I₀ := by
      have e : ∫ x in D₀, f (F + grad Φ x) = ∫ x in D₀, f (A₀ + grad v₀ x) := by
        refine setIntegral_congr_ae hD₀o.measurableSet ?_
        filter_upwards [hgrad, rd_ae_grad_eq_zero hv₁, lam_ae_hasFDerivAt_sawPart j hk0 hl0 hl1]
          with x h1 h2 h3 hx
        have hx0 : v₁ x = 0 := hv₁0 x fun h => Set.disjoint_left.1 hdisj h hx
        have e1 : grad (sawLaminate a j l k) x = _ := lam_grad_smul_of_hasFDerivAt a h3
        rw [h1, h2 hx0, hgψ x hx.1, e1, ite_eq_right (not_lt.2 hx.2.1.le), zero_add, hA₀,
          sub_eq_add_neg, ← neg_smul, add_assoc]
      rw [e, hv₀f f hf A₀, cv_volume_unitCube, ENNReal.toReal_one, inv_one, one_mul,
        measureReal_def]
    have hUm : MeasurableSet (D₁ ∪ D₀) := hD₁o.measurableSet.union hD₀o.measurableSet
    have hUQ : D₁ ∪ D₀ ⊆ unitCube m := union_subset hD₁Q hD₀Q
    have hUvol : volume.real (D₁ ∪ D₀) = volume.real D₁ + volume.real D₀ :=
      measureReal_union hdisj hD₀o.measurableSet hD₁f hD₀f
    have hrest : volume.real (unitCube m \ (D₁ ∪ D₀)) =
        1 - (volume.real D₁ + volume.real D₀) := by
      rw [measureReal_sdiff hUQ hUm hQfin, hQ1, hUvol]
    have hE : ∫ x in unitCube m \ (D₁ ∪ D₀), f (F + grad Φ x) ≤
        C * (1 - (volume.real D₁ + volume.real D₀)) := by
      rw [← hrest]
      refine (le_abs_self _).trans ?_
      rw [← Real.norm_eq_abs]
      refine norm_setIntegral_le_of_norm_le_const_ae'
        ((measure_mono sdiff_subset).trans_lt hQfin.lt_top) ?_
      filter_upwards [hgrad, rd_ae_grad_eq_zero hv₁, rd_ae_grad_eq_zero hv₀] with x h1 h2 h3 hx
      rw [h1, h2 (hv₁0 x fun h => hx.2 (Or.inl h)), h3 (hv₀0 x fun h => hx.2 (Or.inr h)),
        add_zero, add_zero, Real.norm_eq_abs]
      exact hC _ (cv_grad_abs_le hψ x)
    have htot : ∫ x in unitCube m, f (F + grad Φ x) ≤ volume.real D₁ * I₁ + volume.real D₀ * I₀ +
        C * (1 - (volume.real D₁ + volume.real D₀)) := by
      rw [← integral_inter_add_sdiff hUm hint, inter_eq_right.2 hUQ,
        setIntegral_union hdisj hD₀o.measurableSet (hint.mono_set hD₁Q) (hint.mono_set hD₀Q),
        hE₁, hE₀]
      linarith
    refine (iInf₂_le Φ ⟨⟨_, hΦ⟩, hΦ0⟩ : cubeInf f F ≤ _).trans (EReal.coe_le_coe_iff.2 ?_)
    refine htot.trans ?_
    have e1 : volume.real D₁ * I₁ ≤ l * I₁ + lay * |I₁| := by
      have h1 := mul_nonneg (sub_nonneg.2 hm₁) (by linarith [neg_abs_le I₁] : 0 ≤ I₁ + |I₁|)
      have h2 := mul_nonneg (sub_nonneg.2 (sub_le_iff_le_add'.2 hm₁')) (abs_nonneg I₁)
      linarith
    have e0 : volume.real D₀ * I₀ ≤ (1 - l) * I₀ + lay * |I₀| := by
      have h1 := mul_nonneg (sub_nonneg.2 hm₀) (by linarith [neg_abs_le I₀] : 0 ≤ I₀ + |I₀|)
      have h2 := mul_nonneg (sub_nonneg.2 (sub_le_iff_le_add'.2 hm₀')) (abs_nonneg I₀)
      linarith
    have e2 : C * (1 - (volume.real D₁ + volume.real D₀)) ≤ C * (2 * lay) :=
      mul_le_mul_of_nonneg_left (by linarith) hC0
    linarith
  -- the limit `k → ∞`
  have hlim : Tendsto (fun k : ℕ => l * I₁ + (1 - l) * I₀ +
      (|I₁| + |I₀| + 2 * C) * (1 - (1 - 2 * (1 / (k : ℝ))) ^ m)) atTop
      (𝓝 (l * I₁ + (1 - l) * I₀ + (|I₁| + |I₀| + 2 * C) * (1 - (1 - 2 * 0) ^ m))) :=
    tendsto_const_nhds.add (tendsto_const_nhds.mul (tendsto_const_nhds.sub
      ((tendsto_const_nhds.sub (tendsto_const_nhds.mul
        tendsto_one_div_atTop_nhds_zero_nat)).pow m)))
  simp only [mul_zero, sub_zero, one_pow, sub_self, add_zero] at hlim
  exact ge_of_tendsto ((continuous_coe_real_ereal.tendsto _).comp hlim)
    ((eventually_ge_atTop 2).mono key)

/-! ### The two-point inequality -/

/-- The two-point inequality with real bounds `y_A > cubeInf f (F + (1 − λ) a ⊗ e_j)` and
`y_B > cubeInf f (F − λ a ⊗ e_j)`: `rc_le_slabs` for almost minimisers. -/
private theorem rc_two_point_real {f : Matrix (Fin d) (Fin m) ℝ → ℝ} (hf : Continuous f)
    (F : Matrix (Fin d) (Fin m) ℝ) (a : Fin d → ℝ) (j : Fin m) {l : ℝ} (hl0 : 0 < l)
    (hl1 : l < 1) {yA yB : ℝ}
    (hA : cubeInf f (F + (1 - l) • Matrix.vecMulVec a (Pi.single j 1)) < yA)
    (hB : cubeInf f (F - l • Matrix.vecMulVec a (Pi.single j 1)) < yB) :
    cubeInf f F ≤ ((l * yA + (1 - l) * yB : ℝ) : EReal) := by
  unfold cubeInf at hA hB
  obtain ⟨ζ₁, hζ₁⟩ := iInf_lt_iff.1 hA
  obtain ⟨h₁, hζ₁⟩ := iInf_lt_iff.1 hζ₁
  obtain ⟨ζ₀, hζ₀⟩ := iInf_lt_iff.1 hB
  obtain ⟨h₀, hζ₀⟩ := iInf_lt_iff.1 hζ₀
  refine (rc_le_slabs hf F a j hl0 hl1 h₁ h₀).trans (EReal.coe_le_coe_iff.2 ?_)
  have e1 := mul_le_mul_of_nonneg_left (EReal.coe_lt_coe_iff.1 hζ₁).le hl0.le
  have e0 := mul_le_mul_of_nonneg_left (EReal.coe_lt_coe_iff.1 hζ₀).le (sub_nonneg.2 hl1.le)
  linarith

/-- **The two-point inequality of the infimum formula along `a ⊗ e_j`** ([KP], Proposition 8.1
(ii)): for continuous `f`,
`cubeInf f (F) ≤ λ cubeInf f (F + (1 − λ) a ⊗ e_j) + (1 − λ) cubeInf f (F − λ a ⊗ e_j)` (in
`EReal`), the infimum of `rc_le_slabs` over the test maps on the two slabs; a value `−∞` is reached
by `y_A → −∞` or `y_B → −∞` in `rc_two_point_real`. -/
theorem cubeInf_le_two_point {f : Matrix (Fin d) (Fin m) ℝ → ℝ} (hf : Continuous f)
    (F : Matrix (Fin d) (Fin m) ℝ) (a : Fin d → ℝ) (j : Fin m) {l : ℝ} (hl0 : 0 < l)
    (hl1 : l < 1) :
    cubeInf f F ≤ (l : EReal) * cubeInf f (F + (1 - l) • Matrix.vecMulVec a (Pi.single j 1)) +
      ((1 - l : ℝ) : EReal) * cubeInf f (F - l • Matrix.vecMulVec a (Pi.single j 1)) := by
  set A₁ := F + (1 - l) • Matrix.vecMulVec a (Pi.single j (1 : ℝ))
  set A₀ := F - l • Matrix.vecMulVec a (Pi.single j (1 : ℝ))
  have hreal : ∀ yA yB : ℝ, cubeInf f A₁ < yA → cubeInf f A₀ < yB →
      cubeInf f F ≤ ((l * yA + (1 - l) * yB : ℝ) : EReal) := fun yA yB hA hB =>
    rc_two_point_real hf F a j hl0 hl1 hA hB
  set x := cubeInf f A₁ with hx
  set y := cubeInf f A₀ with hy
  have h1l : 0 < 1 - l := by linarith
  have hxt : x < ((f A₁ + 1 : ℝ) : EReal) :=
    (cubeInf_le _).trans_lt (EReal.coe_lt_coe_iff.2 (by linarith))
  have hyt : y < ((f A₀ + 1 : ℝ) : EReal) :=
    (cubeInf_le _).trans_lt (EReal.coe_lt_coe_iff.2 (by linarith))
  by_cases hxb : x = ⊥
  · -- `x = −∞`: then `cubeInf f F = −∞`
    suffices h : cubeInf f F = ⊥ by rw [h]; exact bot_le
    rw [EReal.eq_bot_iff_forall_lt]
    intro z
    refine (hreal ((z - 1 - (1 - l) * (f A₀ + 1)) / l) _ (by rw [hxb]; exact EReal.bot_lt_coe _)
      hyt).trans_lt (EReal.coe_lt_coe_iff.2 ?_)
    rw [mul_div_cancel₀ _ hl0.ne']
    linarith
  by_cases hyb : y = ⊥
  · -- `y = −∞`: then `cubeInf f F = −∞`
    suffices h : cubeInf f F = ⊥ by rw [h]; exact bot_le
    rw [EReal.eq_bot_iff_forall_lt]
    intro z
    refine (hreal _ ((z - 1 - l * (f A₁ + 1)) / (1 - l)) hxt
      (by rw [hyb]; exact EReal.bot_lt_coe _)).trans_lt (EReal.coe_lt_coe_iff.2 ?_)
    rw [mul_div_cancel₀ _ h1l.ne']
    linarith
  -- both values are real
  have ex : x = (x.toReal : EReal) := (EReal.coe_toReal hxt.ne_top hxb).symm
  have ey : y = (y.toReal : EReal) := (EReal.coe_toReal hyt.ne_top hyb).symm
  have hgoal : (l : EReal) * x + ((1 - l : ℝ) : EReal) * y =
      ((l * x.toReal + (1 - l) * y.toReal : ℝ) : EReal) := by
    rw [EReal.coe_add, EReal.coe_mul, EReal.coe_mul, ← ex, ← ey]
  rw [hgoal]
  refine cv_ereal_le_of_eps zero_le_one fun ε hε _ => ?_
  refine (hreal (x.toReal + ε) (y.toReal + ε) ?_ ?_).trans (EReal.coe_le_coe_iff.2 (le_of_eq ?_))
  · rw [ex, EReal.toReal_coe]
    exact EReal.coe_lt_coe_iff.2 (by linarith)
  · rw [ey, EReal.toReal_coe]
    exact EReal.coe_lt_coe_iff.2 (by linarith)
  · ring

/-! ### Every rank-one direction -/

/-- The infimum formula on `Q` is at most the one of `X ↦ f (X Rᵀ)` at `F R`, for an orthogonal `R`:
the latter is the infimum formula on `R Q` (change of variables), and (i) of [KP], Proposition 8.1.
-/
private theorem rc_cubeInf_le_comp_orthogonal {f : Matrix (Fin d) (Fin m) ℝ → ℝ} (hf : Continuous f)
    {R : Matrix (Fin m) (Fin m) ℝ} (hR : Rᵀ * R = 1) (F : Matrix (Fin d) (Fin m) ℝ) :
    cubeInf f F ≤ cubeInf (fun X => f (X * Rᵀ)) (F * R) := by
  have hR' : R * Rᵀ = 1 := mul_eq_one_comm.1 hR
  have hQne : (unitCube m).Nonempty := ⟨fun _ => 1 / 2, fun _ _ => ⟨by norm_num, by norm_num⟩⟩
  rw [← domainInf_unitCube]
  refine (domainInf_le_domainInf hf cv_isOpen_unitCube
    (by rw [cv_volume_unitCube]; exact ENNReal.one_ne_top) hQne (lam_isOpen_image_mulVec hR)
    (lam_isBounded_image_mulVec R) (lam_nonempty_image_mulVec R)
    (Convex.addHaar_frontier volume (lam_convex_image_mulVec R)) F).trans ?_
  refine le_iInf₂ fun φ hφ => ?_
  obtain ⟨⟨K, hK⟩, hφ0⟩ := hφ
  obtain ⟨ψ, K', hψ, hψ0, hgrad⟩ := lam_exists_rotate hR hK hφ0
  refine (iInf₂_le ψ ⟨⟨_, hψ⟩, hψ0⟩).trans (EReal.coe_le_coe_iff.2 (le_of_eq ?_))
  rw [lam_volume_image_mulVec hR, ENNReal.toReal_one, inv_one, one_mul,
    lam_setIntegral_image_mulVec hR]
  simp only [hgrad, Matrix.add_mul, Matrix.mul_assoc, hR', Matrix.mul_one]

/-- **Rotations**: for an orthogonal `R`, `cubeInf f F` is the infimum formula of `X ↦ f (X Rᵀ)` at
`F R` (the infimum formula on the rotated cube `R Q`, by the change of variables `x = R y`). -/
theorem cubeInf_comp_orthogonal {f : Matrix (Fin d) (Fin m) ℝ → ℝ} (hf : Continuous f)
    {R : Matrix (Fin m) (Fin m) ℝ} (hR : Rᵀ * R = 1) (F : Matrix (Fin d) (Fin m) ℝ) :
    cubeInf (fun X => f (X * Rᵀ)) (F * R) = cubeInf f F := by
  have hR' : R * Rᵀ = 1 := mul_eq_one_comm.1 hR
  refine le_antisymm ?_ (rc_cubeInf_le_comp_orthogonal hf hR F)
  have hf' : Continuous fun X : Matrix (Fin d) (Fin m) ℝ => f (X * Rᵀ) :=
    hf.comp (continuous_id.matrix_mul continuous_const)
  have := rc_cubeInf_le_comp_orthogonal hf' (R := Rᵀ) (by rw [Matrix.transpose_transpose, hR'])
    (F * R)
  simpa only [Matrix.transpose_transpose, Matrix.mul_assoc, hR, hR', Matrix.mul_one] using this

/-- **The two-point inequality of the infimum formula in every rank-one direction** ([KP],
Proposition 8.1 (ii)): for continuous `f` and all `a ∈ ℝ^d`, `n ∈ ℝ^m`, `λ ∈ (0, 1)`,
`cubeInf f (F) ≤ λ cubeInf f (F + (1 − λ) a ⊗ n) + (1 − λ) cubeInf f (F − λ a ⊗ n)` (in `EReal`).
Write `a ⊗ n = (|n| a) ⊗ (n / |n|)` and take an orthogonal `R` with `R e_j = n / |n|`
(`exists_orthogonal_mulVec_single_eq`): the inequality is `cubeInf_le_two_point` for `X ↦ f (X Rᵀ)`
at `F R` (`cubeInf_comp_orthogonal`). -/
theorem cubeInf_le_two_point_vecMulVec {f : Matrix (Fin d) (Fin m) ℝ → ℝ} (hf : Continuous f)
    (F : Matrix (Fin d) (Fin m) ℝ) (a : Fin d → ℝ) (n : Fin m → ℝ) {l : ℝ} (hl0 : 0 < l)
    (hl1 : l < 1) :
    cubeInf f F ≤ (l : EReal) * cubeInf f (F + (1 - l) • Matrix.vecMulVec a n) +
      ((1 - l : ℝ) : EReal) * cubeInf f (F - l • Matrix.vecMulVec a n) := by
  rcases eq_or_ne n 0 with rfl | hn
  · -- both sides are `cubeInf f F`
    have h0 : Matrix.vecMulVec a (0 : Fin m → ℝ) = 0 := by ext; simp [Matrix.vecMulVec_apply]
    rw [h0, smul_zero, smul_zero, add_zero, sub_zero]
    rw [← EReal.right_distrib_of_nonneg (EReal.coe_nonneg.2 hl0.le)
      (EReal.coe_nonneg.2 (by linarith)), ← EReal.coe_add, add_sub_cancel, EReal.coe_one, one_mul]
  obtain ⟨j, -⟩ := Function.ne_iff.1 hn
  -- the unit vector `n / |n|`
  have hnn : 0 < n ⬝ᵥ n := by
    refine lt_of_le_of_ne (Finset.sum_nonneg fun i _ => mul_self_nonneg (n i)) ?_
    exact fun h => hn (dotProduct_self_eq_zero.1 h.symm)
  set r := Real.sqrt (n ⬝ᵥ n)
  have hr : 0 < r := Real.sqrt_pos.2 hnn
  have hrr : r * r = n ⬝ᵥ n := Real.mul_self_sqrt hnn.le
  have hn' : (r⁻¹ • n) ⬝ᵥ (r⁻¹ • n) = 1 := by
    rw [smul_dotProduct, dotProduct_smul, smul_eq_mul, smul_eq_mul, ← hrr]
    field_simp
  obtain ⟨R, hR, hRj⟩ := exists_orthogonal_mulVec_single_eq j hn'
  have hf' : Continuous fun X : Matrix (Fin d) (Fin m) ℝ => f (X * Rᵀ) :=
    hf.comp (continuous_id.matrix_mul continuous_const)
  have hRn : Rᵀ.mulVec n = r • Pi.single j 1 := by
    have : n = r • R.mulVec (Pi.single j 1) := by
      rw [hRj, smul_smul, mul_inv_cancel₀ hr.ne', one_smul]
    rw [this, Matrix.mulVec_smul, Matrix.mulVec_mulVec, hR, Matrix.one_mulVec]
  have hdir : Matrix.vecMulVec a n * R = Matrix.vecMulVec (r • a) (Pi.single j 1) := by
    rw [Matrix.vecMulVec_mul, ← Matrix.mulVec_transpose, hRn, Matrix.vecMulVec_smul,
      Matrix.smul_vecMulVec]
  have e1 : F * R + (1 - l) • Matrix.vecMulVec (r • a) (Pi.single j 1) =
      (F + (1 - l) • Matrix.vecMulVec a n) * R := by
    rw [Matrix.add_mul, Matrix.smul_mul, hdir]
  have e0 : F * R - l • Matrix.vecMulVec (r • a) (Pi.single j 1) =
      (F - l • Matrix.vecMulVec a n) * R := by
    rw [Matrix.sub_mul, Matrix.smul_mul, hdir]
  have h := cubeInf_le_two_point hf' (F * R) (r • a) j hl0 hl1
  rwa [e1, e0, cubeInf_comp_orthogonal hf hR, cubeInf_comp_orthogonal hf hR,
    cubeInf_comp_orthogonal hf hR] at h

end CalculusOfVariations
